<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        DPDPA Section 8 — PII Protection in Logs
        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        PII masking is enforced at the application level via PiiMaskingUtil.
        All log statements that reference personal data (email, mobile, name, IP)
        MUST use PiiMaskingUtil.maskXxx() before passing values to the logger.

        This logback configuration does NOT apply pattern-based redaction.
        The defense-in-depth strategy is:
          1. Application-level masking (PiiMaskingUtil) — primary control
          2. Log level management — reduce verbose logging in production
          3. Log access controls — restrict who can read log files (infrastructure)
    -->

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Base Log Level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Specific Log Levels -->
    <logger name="com.bentork.ev_system.service.OcppWebSocketServer" level="INFO" />
    <!-- Reduce noise for regular web requests -->
    <logger name="org.springframework.web" level="INFO"/>
</configuration>
